# ---------------------------------------------------------------------------
# Supabase — Project Settings › API en el dashboard
# ---------------------------------------------------------------------------

# URL del proyecto, ej. https://abcdefghijkl.supabase.co
# Va como NEXT_PUBLIC_* porque la usa también el cliente de @supabase/ssr en
# el middleware (Edge) — no es secreta, es la URL pública del proyecto.
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key. Respeta Row Level Security — es la que usan las
# sesiones de usuario (login, panel de editor). No saltea nada, es seguro
# exponerla al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key. Saltea Row Level Security y habilita el Admin API de Auth
# (crear usuarios de staff). Es una credencial de servidor.
# NUNCA la pongas en una variable NEXT_PUBLIC_* ni la uses desde el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Sólo para `npm run db:seed`: credenciales del admin inicial (Supabase Auth
# necesita un email con formato válido, no alcanza con un usuario suelto).
# ADMIN_EMAIL=admin@chivasbarber.club
# ADMIN_PASSWORD=cambiame

# ---------------------------------------------------------------------------
# Mercado Pago (cobro del turno al confirmar)
# ---------------------------------------------------------------------------

# Access Token de tu app de Mercado Pago (server-side, NUNCA se expone al
# navegador). Dashboard → Tus integraciones → tu app → Credenciales.
MERCADOPAGO_ACCESS_TOKEN=

# Public Key de la misma app. No se usa en el flujo actual (Checkout Pro,
# redirección al init_point), pero queda declarada por si se agrega el botón
# "Wallet" embebido (Checkout Bricks) más adelante.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Clave secreta del webhook (Dashboard → tu app → Webhooks → "Clave
# secreta"). Sin esto, el endpoint de notificaciones no puede validar que el
# aviso de pago viene de verdad de Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública del sitio, sin barra final. Arma `back_urls` y
# `notification_url` al crear la preferencia de pago.
BASE_URL=http://localhost:3000
