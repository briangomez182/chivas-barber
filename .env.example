# Secreto para firmar la cookie de sesión (HMAC-SHA256).
# En producción, generalo con: openssl rand -base64 32
AUTH_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# ---------------------------------------------------------------------------
# Supabase — Project Settings › API en el dashboard
# ---------------------------------------------------------------------------

# URL del proyecto, ej. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# service_role key. Saltea Row Level Security: es una credencial de servidor.
# NUNCA la pongas en una variable NEXT_PUBLIC_* ni la uses desde el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Sólo para `npm run db:seed`: credenciales del admin inicial.
# ADMIN_EMAIL=admin
# ADMIN_PASSWORD=cambiame
